{
 "name": "hf:spring-pop",
 "preset": "keyword",
 "use_when": "a single short keyword that should pop in, no icon",
 "params": {
  "text": {"type": "text", "max": 24, "required": true},
  "color": {"type": "color"}
 },
 "samples": [
  {"text": "Go"},
  {"text": "Name every dollar today!"},
  {"text": "Promo\u00e7\u00e3o s\u00f3 hoje, j\u00e1!"}
 ],
 "natural_duration": 2.0,
 "bind": {"text": "var:text", "color": "css:--brand"},
 "fixed": {"overshoot": 1.4, "fromScale": 0.9},
 "theme_vars": {"--fg": "text", "--brand": "accent", "--border": "chip_border", "--surface": "chip_fill", "--font-body": "font:text", "--font-display": "font:display"},
 "edits": ["E1", "E2:Inter"],
 "font_map": {"Inter": "oh-text"}
}
