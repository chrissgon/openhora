{
 "schema_version": 1,
 "name": "hf:count-up",
 "kind": "overlay",
 "preset": "number",
 "band": "card",
 "may_cross_face": false,
 "license": [
  "Apache-2.0"
 ],
 "source": "hyperframes-registry",
 "use_when": "the line turns on one figure that should count up to its value, with a label under it",
 "params": {
  "value": {
   "type": "text",
   "max": 10,
   "pattern": "[0-9][0-9.,]*",
   "required": true
  },
  "label": {
   "type": "text",
   "max": 40,
   "required": true
  },
  "color": {
   "type": "color"
  }
 },
 "samples": [
  {
   "value": "7",
   "label": "Go"
  },
  {
   "value": "123.456,78",
   "label": "visits we counted over the whole summer"
  },
  {
   "value": "42",
   "label": "Pedidos de caf\u00e9, \u00e7a va"
  }
 ],
 "natural_duration": 2.2,
 "implementations": {
  "gsap": "gsap.html"
 },
 "tier": "B",
 "commit": "b4cc674f7f312e77ded32e0b53006cc0bad6723b",
 "notice": "Apache-2.0; adapted from the HyperFrames registry at b4cc674f; notices in providers/renderer/hf-runtime/NOTICE.md"
}
