{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "an animation block of the catalogue: a block.json, or an entry of hf/allowlist.json",
 "description": "The loader (providers/renderer/_blocks.py) enforces this and what a schema cannot say: the name against its folder, the band against the kind, may_cross_face a boolean (no gate reads it but the old engine's pixel check, which leaves out the frames of a full-frame layout), a sample against the parameters, an implementation file against blocks/pins.json or the entry's files, the hf: keys by namespace and tier, no image or clip parameter in an hf: block.",
 "$defs": {
  "block": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "kind", "preset", "band", "may_cross_face", "license", "source", "use_when", "params", "samples", "natural_duration", "implementations"],
   "properties": {
    "schema_version": {"const": 1, "description": "block.json only; an allowlist entry has none"},
    "name": {"type": "string", "pattern": "^(oh|hf):[a-z][a-z0-9-]{0,39}$"},
    "kind": {"enum": ["overlay", "layout", "caption", "effect"]},
    "preset": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,31}$"},
    "band": {"enum": ["card", "frame", "caption"]},
    "may_cross_face": {"type": "boolean"},
    "license": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["MIT", "Apache-2.0", "OFL-1.1"]}},
    "source": {"enum": ["openhora", "hyperframes-registry"]},
    "use_when": {"type": "string", "minLength": 3, "maxLength": 120},
    "params": {"type": "object", "maxProperties": 12, "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,31}$"}, "additionalProperties": {"$ref": "#/$defs/param"}},
    "samples": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object"}},
    "natural_duration": {"type": ["number", "null"], "minimum": 0.2, "maximum": 60},
    "implementations": {"type": "object", "minProperties": 1, "maxProperties": 2, "propertyNames": {"enum": ["renderat", "gsap", "hf"]}, "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}\\.html$"}},
    "tier": {"enum": ["A", "B"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "notice": {"type": "string", "minLength": 1, "maxLength": 200},
    "files": {"type": "object", "minProperties": 1, "maxProperties": 50, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "component": {"type": "string", "description": "the registry folder of the component of a block that runs on the second page contract (runtime hf); the names of files are relative to it"},
    "edits": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^(E1|E2:[A-Za-z][A-Za-z0-9 ]{0,40})$"}},
    "font_map": {"type": "object", "description": "the host family each family an E2 edit renames becomes", "additionalProperties": {"enum": ["oh-display", "oh-text", "oh-mono"]}},
    "served_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bind": {"type": "object", "description": "each of our parameters to a component variable (var:ID) or a CSS custom property of the host root (css:--prop)", "additionalProperties": {"type": "string", "pattern": "^(var:[A-Za-z][A-Za-z0-9_]{0,31}|css:--[a-z][a-z0-9-]{0,40})$"}},
    "fixed": {"type": "object", "description": "the variables no parameter reaches", "maxProperties": 20},
    "theme_vars": {"type": "object", "description": "the component's CSS variables to our theme: a colour token or font:ROLE, never --bg", "additionalProperties": {"type": "string"}},
    "determinism": {"type": "object", "additionalProperties": false, "required": ["served_sha256", "runtime_sha256", "samples", "frames", "runs", "blocked", "date", "image", "seconds"],
                    "properties": {"served_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "samples": {"type": "integer", "minimum": 1}, "frames": {"type": "integer", "minimum": 1}, "runs": {"const": 4}, "blocked": {"const": 0}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "image": {"type": "string"}, "seconds": {"type": "number", "minimum": 0}}}
   }
  },
  "param": {
   "type": "object",
   "additionalProperties": false,
   "required": ["type"],
   "properties": {
    "type": {"oneOf": [{"enum": ["text", "icon", "color", "choice", "image", "clip", "number"]}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["image", "clip"]}}]},
    "required": {"type": "boolean"},
    "default": {},
    "max": {"type": "number"},
    "max_items": {"type": "integer", "minimum": 1, "maximum": 8},
    "pattern": {"type": "string", "maxLength": 80},
    "values": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}},
    "min": {"type": "number"},
    "integer": {"type": "boolean"}
   }
  }
 }
}
