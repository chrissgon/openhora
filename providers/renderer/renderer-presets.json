    "width_frac": 0.6,
    "radius_px": 28,
    "max_height": 1300,
    "push": 0.04,
    "enter_seconds": 0.22,
    "enter_from": 0.06,
    "exit_seconds": 0.18,
    "stamp_delay": 0.55,
    "stamp_seconds": 0.4,
    "stamp_from": 1.8,
    "stamp_size": 0.26,
    "stamp_stroke": 64,
    "stamp_tilt": -8,
    "stamp_x_color": "#FF3B30",
    "stamp_check_color": "#34C759"
   }
