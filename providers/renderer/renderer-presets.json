{
 "version": 1,
 "note": "What the renderer decides about the closed vocabulary shared/references/video-presets.json: the frame, the default colours, the timing of each preset and the limits. The vocabulary (names, parameters, bounds) is read from that file by flag; nothing here repeats it. A test holds the presets, the blocks that draw them (blocks/engines/ffmpeg.json) and the parameters each block's page reads equal to the vocabulary.",
 "frame": {
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "fps_min": 24,
  "fps_max": 60,
  "safe": {
   "left": 65,
   "right": 65,
   "top": 285,
   "bottom": 1248
  }
 },
 "pip": {
  "size": 380
 },
 "theme": {
  "colors": {
   "bg": "#0B0F14",
   "text": "#FFFFFF",
   "muted": "#A8B0BC",
   "accent": "#FFC93C",
   "chip_fill": "#1B1F2A",
   "chip_text": "#FFE08A",
   "chip_border": "#FFC93C"
  },
  "font_roles": [
   "display",
   "text",
   "mono"
  ],
  "default_font_weight": {
   "display": 800,
   "text": 500,
   "mono": 500
  },
  "system_fallback": {
   "display": "-apple-system, \"Helvetica Neue\", Arial, sans-serif",
   "text": "-apple-system, \"Helvetica Neue\", Arial, sans-serif",
   "mono": "Menlo, ui-monospace, monospace"
  }
 },
 "caption": {
  "positions": [
   "bottom",
   "center"
  ],
  "max_words": 3,
  "max_chars": 22,
  "hold": 0.2,
  "pause": 0.6
 },
 "limits": {
  "words_max": 4000,
  "word_chars_max": 40,
  "kept_ranges_max": 600,
  "input_seconds_max": 300,
  "frames_max": 27000,
  "asset_max_side": 8192,
  "asset_max_pixels": 40000000,
  "asset_max_bytes": 67108864,
  "font_max_bytes": 5242880,
  "json_max_bytes": 5242880,
  "render_seconds_base": 120,
  "render_seconds_per_output_second": 25,
  "render_seconds_max": 1800,
  "frame_bytes_estimate": 250000
 },
 "presets": {
  "keyword": {
   "anchor": "match_text",
   "min_duration": 1.0,
   "max_duration": 1.8,
   "tail": 0.3,
   "settled": 0.4,
   "looks": {}
  },
  "list": {
   "anchor": "window",
   "min_duration": 2.0,
   "max_duration": 8.0,
   "tail": 0.5,
   "settled": 2.0,
   "looks": {}
  },
  "number": {
   "anchor": "window",
   "min_duration": 2.0,
   "max_duration": 6.0,
   "tail": 0.6,
   "settled": 1.55,
   "looks": {}
  },
  "quote": {
   "anchor": "window",
   "min_duration": 2.0,
   "max_duration": 7.0,
   "tail": 0.5,
   "settled": 0.85,
   "looks": {}
  },
  "cutaway": {
   "anchor": "window",
   "min_duration": 1.5,
   "max_duration": null,
   "tail": 0.2,
   "settled": 0.65,
   "page_images": true,
   "looks": {
    "transition": "cut",
    "glass_blur_px": 48,
    "glass_tint_alpha": 0.45,
    "glass_ratio_max": 0.8,
    "glass_radius_px": 24
   }
  },
  "pip": {
   "anchor": "window",
   "min_duration": 1.5,
   "max_duration": null,
   "tail": 0.2,
   "settled": 0.5,
   "looks": {}
  },
  "mark": {
   "anchor": "match_text",
   "min_duration": 1.2,
   "max_duration": 2.4,
   "tail": 0.3,
   "settled": 0.4,
   "looks": {}
  },
  "sticker": {
   "anchor": "match_text",
   "min_duration": 0.8,
   "max_duration": 1.8,
   "tail": 0.3,
   "settled": 0.4,
   "looks": {}
  },
  "nametag": {
   "anchor": "match_text",
   "min_duration": 2.5,
   "max_duration": 4.0,
   "tail": 0.3,
   "settled": 0.4,
   "looks": {}
  }
 },
 "review_presets": {
  "mark": {
   "kind": "overlay",
   "summary": "a short phrase drawn large with a hand-drawn underline, circle or arrow",
   "main": "text",
   "params": {
    "text": {
     "type": "text",
     "max": 24,
     "required": true
    },
    "mark": {
     "type": "choice",
     "values": [
      "underline",
      "circle",
      "arrow",
      "none"
     ],
     "default": "underline"
    },
    "color": {
     "type": "color"
    }
   }
  },
  "sticker": {
   "kind": "overlay",
   "summary": "a drawn symbol pops beside the speaker's point",
   "main": "glyph",
   "params": {
    "glyph": {
     "type": "choice",
     "values": [
      "check",
      "star",
      "bolt",
      "arrow-up",
      "heart",
      "flag",
      "clock",
      "coin",
      "bulb",
      "question",
      "exclaim",
      "eye"
     ],
     "required": true
    },
    "side": {
     "type": "choice",
     "values": [
      "left",
      "center",
      "right"
     ],
     "default": "right"
    },
    "color": {
     "type": "color"
    }
   }
  },
  "nametag": {
   "kind": "overlay",
   "summary": "the speaker's name and role slide in",
   "main": "name",
   "params": {
    "name": {
     "type": "text",
     "max": 32,
     "required": true
    },
    "role": {
     "type": "text",
     "max": 40
    },
    "color": {
     "type": "color"
    }
   }
  }
 },
 "zones": {
  "card_top": 110,
  "gap": 18,
  "caption_bottom": 1560,
  "caption_margin": 14,
  "card_min_height": 80,
  "caption_min_height": 120,
  "note": "The face box splits the frame: cards (keyword, list, number, quote) live in the band above it, from card_top down to the face box (as the zoom leaves it) less gap; captions live in the band below it, from the face box plus gap down to caption_bottom. The render fails when a drawn card or caption touches the face box. 1560 clears the apps' interface (VD12); a drawn caption below it fails the render."
 },
 "face_box_default": {
  "x": 240,
  "y": 620,
  "w": 600,
  "h": 560
 },
 "zoom": {
  "modes": [
   "alternate",
   "none"
  ],
  "default_mode": "alternate",
  "factor": 1.1,
  "factor_max": 1.25,
  "push_in": 0.02,
  "push_in_max": 0.03,
  "anchor_y": 0.25,
  "audio_fade_seconds": 0.015
 },
 "punch": {"factor": 1.12, "min_seconds": 0.8, "max_seconds": 3.0},
 "effects": {
  "flash_alphas": [0.85, 0.6, 0.35, 0.1],
  "dip_alphas": [0.3, 0.6, 0.85, 0.85, 0.6, 0.3],
  "tint_alpha": 0.18,
  "grade_min_seconds": 0.5,
  "grade_max_seconds": 4.0
 },
 "cuts": {
  "min_cut": 0.12,
  "min_kept": 0.4,
  "gap": 0.5,
  "noise_db": -35,
  "min_silence": 0.25,
  "long_cut": 2.0,
  "wordless_max": 0.3,
  "pad_head": 0.1,
  "pad_tail": 0.14,
  "wordless_keep": 1.5,
  "phantom_max_seconds": 0.02,
  "phantom_run_min": 3,
  "phantom_edge_seconds": 0.05,
  "phantom_repeat_min": 5
 },
 "retakes": {
  "window_seconds": 20.0,
  "run_min": 3,
  "restart_min": 2,
  "fragment_min_chars": 2,
  "tail_propose_max": 60,
  "tail_cut_max": 6,
  "cut_seconds_max": 10.0,
  "redo_words_max": 45,
  "redo_seconds_max": 16.0,
  "redo_later_share": 0.4,
  "coordination_between_min": 2,
  "retake_pause": 1.0,
  "phrase_pause": 0.6,
  "near_min_tokens": 4,
  "near_head_tokens": 2,
  "near_ratio": 0.8,
  "near_edits_max": 2,
  "near_gap_max": 3.0,
  "punctuation_min_share": 0.03,
  "proposals_max": 100,
  "words": {
   "*": {"hesitation": ["hmm", "hm", "mm", "uhm"], "filler": [], "cue": [], "connector": [], "conjunction": []},
   "pt": {
    "hesitation": ["ahn", "\u00e3h", "h\u00e3", "hum", "éé", "ééé", "aa", "aaa", "eee"],
    "filler": ["é", "né", "tipo", "ent\u00e3o", "aí", "bom", "olha", "assim", "ah", "eh", "uh"],
    "conjunction": ["e", "ou", "nem"],
    "connector": ["e", "mas", "ent\u00e3o", "porque", "por\u00e9m", "que", "s\u00f3 que"],
    "cue": ["desculpa", "desculpe", "perd\u00e3o", "pera", "peraí", "espera", "calma", "corta", "de novo", "vou de novo", "vou repetir", "deixa eu", "come\u00e7ando de novo"]
   },
   "en": {
    "hesitation": ["uh", "um", "er", "erm"],
    "filler": ["so", "well", "like", "ah"],
    "conjunction": ["and", "or", "nor"],
    "connector": ["and", "but", "so", "because", "that"],
    "cue": ["sorry", "wait", "again", "scratch that", "start over", "let me start over", "let me try again", "cut"]
   }
  }
 },
 "storyboard": {
  "note": "The storyboard draws each beat at `settled` seconds into it (per preset, above): the longest entrance of the template, from its easing, at the vocabulary's largest parameters and a long beat; a beat too short for that is drawn at its end less its tail less one frame. The storyboard verb (no recording, no transcript): each beat's line is split into words spoken at words_per_second (2.5, the speaking rate of P3b; a test holds the two equal once both files carry it), one beat after another with beat_gap seconds between them, and trail seconds after the last word so that no beat is cut short by the video's end. Every time here is a whole number of frames at 30 fps, so every beat starts on a frame. The page is drawn over `backdrop`; a layout's asset slot is filled with `slot_fill`. The contact sheet is a grid of tile_width x tile_height tiles in rows of `columns`, `gap` pixels apart, on `fill`.",
  "words_per_second": 2.5,
  "beat_gap": 2.0,
  "trail": 2.5,
  "time_limit_seconds": 120,
  "backdrop": "#2E343D",
  "slot_fill": "#59626F",
  "sheet": {
   "columns": 4,
   "tile_width": 270,
   "tile_height": 480,
   "gap": 12,
   "fill": "#14181E"
  }
 },
 "preview": {
  "note": "The preview verb: a copy of a finished render small enough for a phone (Telegram sends at most 20 MiB, WhatsApp through Twilio 16 MB). 720x1280 H.264, CRF 23 capped by a rate computed from the render's length so that the whole file fits max_bytes with `margin` of room (the audio's share taken first, one second added for the container), at most max_video_kbps; a render that would need less than min_video_kbps is refused. One encoder thread, so the same render gives the same bytes on any machine. Measured on synthetic test patterns: 60 s gave 14,101,201 bytes in 21 s, 300 s gave 15,053,020 bytes in 72 s.",
  "width": 720,
  "height": 1280,
  "crf": 23,
  "preset": "medium",
  "max_bytes": 15728640,
  "margin": 0.94,
  "audio_kbps": 96,
  "max_video_kbps": 2500,
  "min_video_kbps": 250,
  "duration_tolerance_seconds": 0.2,
  "encode_seconds": 840,
  "time_limit_seconds": 900
 }
}
