    "styles": {
     "a": {"caps": true, "fg": "accent", "note_style": "none", "note_color": "muted", "note_size": 0, "note_caps": false},
     "b": {"caps": false, "fg": "text", "note_style": "small", "note_color": "muted", "note_size": 54, "note_caps": false},
     "c": {"caps": true, "fg": "text", "note_style": "small", "note_color": "accent", "note_size": 50, "note_caps": true}
    }
   }
  }
 },
 "review_presets": {
  "mark": {
   "kind": "overlay",
   "summary": "a short phrase drawn large with a hand-drawn underline, circle, arrow, X over it or strike through it",
   "main": "text",
   "params": {
    "text": {
     "type": "text",
     "max": 24,
     "required": true
    },
    "mark": {
     "type": "choice",
     "values": [
      "underline",
      "circle",
      "arrow",
      "cross",
      "strike",
      "none"
     ],
     "default": "underline"
    },
    "color": {
     "type": "color"
    }
   }
  },
  "sticker": {
   "kind": "overlay",
   "summary": "a drawn symbol pops beside the speaker's point",
   "main": "glyph",
   "params": {
    "glyph": {
     "type": "choice",
     "values": [
      "check",
      "star",
      "bolt",
      "arrow-up",
      "heart",
      "flag",
      "clock",
      "coin",
      "bulb",
      "question",
      "exclaim",
      "eye",
      "cross"
     ],
     "required": true
    },
    "side": {
     "type": "choice",
     "values": [
      "left",
      "center",
      "right"
     ],
     "default": "right"
    },
    "color": {
     "type": "color"
    }
   }
  },
  "nametag": {
   "kind": "overlay",
   "summary": "the speaker's name and role slide in",
   "main": "name",
   "params": {
    "name": {
     "type": "text",
     "max": 32,
     "required": true
    },
    "role": {
     "type": "text",
     "max": 40
    },
    "color": {
     "type": "color"
    }
   }
  },
  "focus_card": {
   "kind": "layout",
   "summary": "a picture of yours as a card in the middle, over your own shot blurred and greyed",
   "main": "label",
   "params": {
    "asset": {
     "type": "image",
     "required": true
    },
    "label": {
     "type": "text",
     "max": 40
    },
    "stamp": {
     "type": "choice",
     "values": [
      "none",
      "x",
      "check"
     ],
     "default": "none"
    },
    "backdrop": {
     "type": "choice",
     "values": [
      "blur",
      "none"
     ],
     "default": "blur"
    }
   }
  },
  "title_card": {
   "kind": "layout",
   "summary": "one keyword large on a full-screen card, over your own shot blurred and greyed",
   "main": "text",
   "params": {
    "text": {
     "type": "text",
     "max": 40,
     "required": true
    },
    "note": {
     "type": "text",
     "max": 60
    },
    "style": {
     "type": "choice",
     "values": [
      "a",
      "b",
      "c"
     ],
     "default": "c"
    },
    "color": {
     "type": "color"
    },
    "backdrop": {
     "type": "choice",
     "values": [
      "blur",
      "none"
     ],
     "default": "blur"
    }
   }
  }
 },
 "zones": {
  "card_top": 110,
  "gap": 18,
  "caption_bottom": 1560,
  "caption_margin": 14,
  "card_min_height": 80,
  "caption_min_height": 120,
  "note": "The face box splits the frame: by default cards (keyword, list, number, quote) are placed in the band above it, from card_top down to the face box (as the zoom leaves it) less gap; captions in the band below it, from the face box plus gap down to caption_bottom. These are where things go by default, not limits: a band the face leaves under card_min_height or caption_min_height is clamped to that minimum and the render reports advice (card_room_small, caption_room_small), and a caption drawn below caption_bottom (1560 clears the apps' interface, VD12) is reported as advice (caption_below_line). Nothing refuses a render for where a card or a caption is drawn (the maintainer's principle of 2026-11-24)."
 },
 "face_box_default": {
  "x": 240,
  "y": 620,
  "w": 600,
  "h": 560
 },
 "zoom": {
  "modes": [
   "alternate",
   "none"
  ],
  "default_mode": "alternate",
  "factor": 1.1,
  "push_in": 0.02,
  "push_min_seconds": 5.0,
  "anchor_y": 0.25,
  "audio_fade_seconds": 0.015
 },
 "punch": {"factor": 1.12, "min_seconds": 0.8},
 "effects": {
  "flash_alphas": [0.85, 0.6, 0.35, 0.1],
  "dip_alphas": [0.3, 0.6, 0.85, 0.85, 0.6, 0.3],
  "tint_alpha": 0.18,
  "grade_min_seconds": 0.5
 },
 "transitions": {
  "note": "Transitions at joins (P1a): the defaults of each ffmpeg-drawn kind, one intensity per frame (`lead` of them come before the anchor frame). Defaults only: the bounds are validity (_edl.check_transition_config). No limit on the face (2026-11-26).",
  "kinds": {
   "glitch": {"lead": 1, "intensity": [0.6, 1.0, 0.6]},
   "bloom": {"lead": 1, "intensity": [0.6, 1.0, 0.6], "threshold": 180, "sigma": 10, "opacity": 0.9},
   "zoom_blur": {"lead": 1, "intensity": [0.6, 1.0, 0.6], "copies": 6, "spread": 0.08, "shift_px": 4},
   "blur_to_card": {"lead": 2, "intensity": [0.5, 1.0, 0.5], "sigma": 24, "darken": 0.5},
   "dip": {"lead": 1, "intensity": [0.6, 1.0, 0.6]}
  }
 },
 "backdrop": {
  "note": "The blurred shot under a beat whose `backdrop` is `blur` (video P4b): ffmpeg blurs, greys and darkens the speaker's own picture over the beat's frames, under every card, picture and caption. Defaults only: the bounds are validity (_edl.check_backdrop_config). No limit on the face (P4-1, 2026-11-28). `saturation` 1 keeps the colour and 0 is fully grey; `darken` mixes toward the theme's bg.",
  "blur": {"sigma": 40, "darken": 0.5, "saturation": 0.5}
 },
 "cuts": {
  "min_cut": 0.12,
  "min_kept": 0.4,
  "gap": 0.5,
  "noise_db": -35,
  "min_silence": 0.25,
  "long_cut": 2.0,
  "wordless_max": 0.3,
  "pad_head": 0.1,
