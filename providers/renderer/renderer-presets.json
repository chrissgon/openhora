  "title_card": {
   "anchor": "window",
   "min_duration": 1.0,
   "max_duration": null,
   "tail": 0.3,
   "settled": 0.4,
   "page_images": false,
   "looks": {
    "max_w": 930,
    "max_h": 1100,
    "start_size": 360,
    "enter_seconds": 0.28,
    "exit_seconds": 0.2,
    "rise_em": 0.18,
    "enter_scale": 0.08,
