# Secrets never live in this repo. Providers read credentials from the environment.
.env
.env.*
!.env.example

# Adapter build outputs are regenerated by adapters/<harness>/build.*
adapters/*/build/
# What an installer wrote outside the repository, so that its uninstall can put it back
adapters/*/installed/

# Eval workspaces written by evals/eval_run.py
*-workspace/

# Python
__pycache__/
*.pyc

# OS / editors
.DS_Store

# A maintainer's own names, projects and accounts, one per line; read by scripts/validate.py (private-term)
.private-terms

# The site's demo is built at deploy time by scripts/build_demo.py (netlify.toml)
site/demo/

# The WhatsApp program is built by providers/messenger/whatsapp.py into the state folder, never here; a `go build` or
# `go test -c` run by hand in its source folder must not be committed
/providers/messenger/whatsapp/whatsapp
/providers/messenger/whatsapp/whatsapp.test
