# Files that define the repository's rules and its checks: changes need the owner's review.
/AGENTS.md                 @chrissgon
/contracts/                @chrissgon
/scripts/validate.py       @chrissgon
/scripts/security_scan.py  @chrissgon
/.githooks/                @chrissgon
/.github/                  @chrissgon
/providers/CONTRACT.md     @chrissgon

# What decides what a run measures, and what moves a skill's standing (the reliability model, section 8):
# a change that weakens a check, moves the measurement or adds evidence is seen by the owner. Lab evidence on
# the reference model comes from tests the owner runs; nothing else proves a line was written by the runner.
/evals/                        @chrissgon
/adapters/claude-code/run-prompt.sh   @chrissgon
/adapters/claude-code/adapter.json    @chrissgon
/adapters/agents-dir/run-prompt.sh    @chrissgon
/adapters/agents-dir/adapter.json     @chrissgon
/adapters/claude-code/eval.json       @chrissgon
/adapters/agents-dir/eval.json        @chrissgon
/adapters/*/install.sh         @chrissgon
/adapters/claude-code/build.py @chrissgon
/scripts/stage_skills.py       @chrissgon
/scripts/redact.py             @chrissgon
/scripts/test_dirs.py          @chrissgon
/scripts/select_tests.py       @chrissgon   # which tests run: a narrower selection weakens a check
/scripts/test_slots.py         @chrissgon
/scripts/evidence.py           @chrissgon
/scripts/image_lock.py         @chrissgon
# Community evidence (decision D19): the official reusable workflow that signs it, the check that verifies it, and the
# script that packs it. A change to any of them changes what a fork's attested run can be, so the owner sees it.
/.github/workflows/community-eval.yml    @chrissgon
/.github/workflows/community-verify.yml  @chrissgon
/scripts/verify_community.py   @chrissgon
/scripts/community_pack.py     @chrissgon
/.security-scan-allow          @chrissgon
/shared/                       @chrissgon
/skills/*/evals/evidence/      @chrissgon
/skills/*/evals/versions.jsonl @chrissgon

# The task runtime: what runs a skill for a person, what may enter a run and what may come back from it.
/runtime/                      @chrissgon
/interface/                    @chrissgon
/flows/                        @chrissgon
/skills/*/evals/runtime-manifest.json @chrissgon

# The hash pins of the test suite (route rows, approval digests, the interpreter's enabling hashes) and the guard that keeps them in one file:
# a change of a pinned value is a decision, so the owner sees it.
/scripts/tests/pinned_hashes.json      @chrissgon
/scripts/tests/test_pinned_hashes.py   @chrissgon
