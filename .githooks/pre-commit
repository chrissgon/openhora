#!/usr/bin/env bash
# Pre-commit checks for the workbench. Enable them once per clone: bash scripts/install-hooks.sh
#
# 1. scripts/validate.py: conventions and the security scan. It reads the working tree, not only
#    what is staged, so a file with a finding blocks the commit even if it is not part of it. Its version
#    rules read a change against the merge base of HEAD with the default branch, the same base CI passes
#    (WB_BASE_REF), never against HEAD: an edit and its bump in two commits are read as one change.
# 2. scripts/security_scan.py --strict: a security warning (hidden text, a shell run on a built string,
#    an unguarded recursive delete, an unpinned dependency...) blocks the commit like an error does.
# 3. The tests of providers/<class>/, scripts/, evals/, runtime/ (also when a flow file under flows/ or a file
#    under interface/ changed), shared/, an adapter or a skill's scripts/ (its scripts/tests/ folder, also when only a
#    test changed) when the commit touches them; a provider
#    class left without tests is refused. A commit that touches .githooks/, .github/, packs/, templates/
#    or agents/ runs scripts/tests, where the tests of that wiring, of the installers and of the scaffold are.
#    A commit that touches shared/ or a generated copy (shared/scripts/copies.json lists them) also runs
#    scripts/tests, where the identity test of the copies is; the validator of step 1 already refuses an
#    adopted copy that differs from its source.
#
# Skipping the hook (git commit --no-verify) is the user's decision, never a skill's.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() { echo "pre-commit: $1" >&2; exit 1; }

if ! out="$(python3 scripts/validate.py 2>&1 >/dev/null)"; then
  echo "$out" >&2
  fail "scripts/validate.py found errors (listed above). Fix them; an intended security finding is silenced on its line with 'security-scan: allow <rule> -- <reason>'."
fi
# The standing convention warnings of the validator are not shown. Security warnings fail the commit:
# same step as the validate job of .github/workflows/checks.yml.
if ! out="$(python3 scripts/security_scan.py --strict 2>&1 >/dev/null)"; then
  echo "$out" >&2
  fail "scripts/security_scan.py --strict found warnings (listed above). Fix them; an intended one is silenced on its line with 'security-scan: allow <rule> -- <reason>'."
fi

# NUL-separated so names with spaces or non-ASCII characters are not quoted; no rename detection,
# so a file moved out of providers/, scripts/, evals/ or an adapter still counts for the folder it left.
dirs=()
copies="$(python3 scripts/sync_copies.py --destinations 2>/dev/null || true)"
while IFS= read -r -d '' f; do
  # A shared source, the manifest or a generated copy: the identity test of the copies is in scripts/tests.
  if [[ "$f" == shared/* ]] || grep -qxF -- "$f" <<<"$copies"; then
    if [[ " ${dirs[*]-} " != *" scripts/tests "* ]]; then dirs+=("scripts/tests"); fi
  fi
  case "$f" in
    shared/*) d="shared/scripts/tests" ;;  # the tests of a shared script live at its source
    providers/*/*) d="providers/$(echo "$f" | cut -d/ -f2)/tests" ;;
    providers/*) d="scripts/tests" ;;  # providers/resolve.py: its tests are scripts/tests/test_provider_resolve.py
    scripts/*) d="scripts/tests" ;;
    .githooks/*|.github/*|packs/*|templates/*|agents/*) d="scripts/tests" ;;
    evals/execution.py) d="evals/tests"  # the runtime's lab facade (runtime/lab.py) loads the execution kit
      [[ " ${dirs[*]-} " != *" runtime/tests "* ]] && dirs+=("runtime/tests") ;;
    evals/*) d="evals/tests" ;;
    runtime/*|flows/*|interface/*) d="runtime/tests" ;;  # a flow file, a page of the interface: checked by the tests of the code that reads it
    skills/*/evals/runtime-manifest.json) d="runtime/tests" ;;  # read by runtime/manifest.py, before any skills/* pattern
    skills/*/scripts/*) d="skills/$(echo "$f" | cut -d/ -f2)/scripts/tests" ;;
    adapters/*/*) d="adapters/$(echo "$f" | cut -d/ -f2)/tests" ;;
    *) continue ;;
  esac
  if [[ ! -d "$d" ]]; then
    # A provider acts on the outside world, so it cannot lose its tests (providers/CONTRACT.md).
    # A class removed entirely has no folder left and is not checked.
    [[ "$d" == providers/* && -d "$(dirname "$d")" ]] \
      && fail "$(dirname "$d") has no tests; add offline tests in $d (providers/CONTRACT.md)."
    continue
  fi
  [[ " ${dirs[*]-} " != *" $d "* ]] && dirs+=("$d")
done < <(git diff --cached --name-only -z --no-renames --diff-filter=ACMRD)

if [[ ${#dirs[@]} -gt 0 ]]; then
  command -v uv >/dev/null || fail "uv is needed to run the tests in ${dirs[*]}: https://docs.astral.sh/uv/"
  # Same pin as .github/workflows/checks.yml. Git exports GIT_DIR and GIT_INDEX_FILE to hooks; tests that
  # create their own repositories would otherwise read this one.
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
    uv run --quiet --with pytest==9.1.1 pytest -q "${dirs[@]}" || fail "tests failed in ${dirs[*]}."
fi
