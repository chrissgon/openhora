{
 "v": 1,
 "observed": [
  "executed",
  "card",
  "confirm",
  "remind_confirm",
  "read",
  "answer",
  "clarify",
  "route",
  "none",
  "refuse_d",
  "refuse_g",
  "refuse_policy",
  "forwarded",
  "outage"
 ],
 "observed_meaning": {
  "executed": "a state change with no confirmation or card",
  "card": "an E card opened",
  "confirm": "a code confirmation for W, G-operational, N other than remind",
  "remind_confirm": "the confirmation of a reminder's reading",
  "read": "R or ask ran",
  "answer": "an open item was answered",
  "clarify": "a question was asked back",
  "route": "the line went to the router",
  "none": "nothing was done",
  "refuse_d": "a D was refused",
  "refuse_g": "a widening G was refused",
  "refuse_policy": "the policy refused the op",
  "forwarded": "the line was a forward and was answered as such",
  "outage": "the model call failed"
 },
 "severity": [
  "wrong_effect_unconfirmed",
  "wrong_card",
  "wrong_reminder_reading",
  "wrong_item_binding",
  "wrong_read",
  "wrong_route",
  "missed",
  "clarify",
  "correct"
 ],
 "matching": "equal outcome and op, the same slot-name set, each value natural.normal-equal to an accepted one (ints equal), time in gold.time when either side has one; answer: same item and keys; refuse: same class; or any `also` matches",
 "scopes": {
  "full": "every rule applies",
  "op": "only the rules on op identity",
  "time": "the time reading only, reported apart"
 },
 "rules": [
  {
   "n": 1,
   "observed": [
    "executed"
   ],
   "when": "always",
   "category": "wrong_effect_unconfirmed",
   "text": "executed -> wrong_effect_unconfirmed"
  },
  {
   "n": 2,
   "observed": [
    "card",
    "confirm"
   ],
   "when": "not matching",
   "category": "wrong_card",
   "text": "card or confirm not matching -> wrong_card"
  },
  {
   "n": 3,
   "observed": [
    "remind_confirm"
   ],
   "when": "not matching",
   "category": "wrong_reminder_reading",
   "text": "remind_confirm not matching -> wrong_reminder_reading"
  },
  {
   "n": 4,
   "observed": [
    "answer"
   ],
   "when": "not matching",
   "or_gold": {
    "outcome": "answer",
    "observed": [
     "read",
     "route"
    ]
   },
   "category": "wrong_item_binding",
   "text": "answer not matching, or gold answer with observed read or route -> wrong_item_binding"
  },
  {
   "n": 5,
   "observed": [
    "read"
   ],
   "when": "not matching",
   "category": "wrong_read",
   "text": "read not matching -> wrong_read"
  },
  {
   "n": 6,
   "observed": [
    "route"
   ],
   "when": "gold is not route",
   "category": "wrong_route",
   "text": "route with gold other than route -> wrong_route"
  },
  {
   "n": 7,
   "observed": [
    "clarify"
   ],
   "when": "gold is not clarify",
   "category": "clarify",
   "text": "clarify with gold other than clarify -> clarify"
  },
  {
   "n": 8,
   "observed": "any",
   "when": "matching",
   "category": "correct",
   "text": "matching -> correct"
  },
  {
   "n": 9,
   "observed": "any",
   "when": "otherwise",
   "category": "missed",
   "text": "anything else (none, outage, refusals, forwarded on a non-forward, a clarify gold met by none) -> missed"
  }
 ],
 "metrics": [
  {
   "name": "N",
   "formula": "count of items"
  },
  {
   "name": "rate(c)",
   "formula": "count(c) / N for each of the six wrong_* categories"
  },
  {
   "name": "correct_direct",
   "formula": "count(correct and gold other than clarify) / count(gold other than clarify)"
  },
  {
   "name": "clarify_rate",
   "formula": "count(clarify) / count(gold other than clarify)"
  },
  {
   "name": "parse_failure_rate",
   "formula": "calls with parse invalid / calls"
  },
  {
   "name": "p95_latency_ms",
   "formula": "95th percentile over the calls of sequential events"
  },
  {
   "name": "median_cost_usd",
   "formula": "median cost per call in the production configuration (caching on)"
  },
  {
   "name": "wrong_route_cost_usd",
   "formula": "count(wrong_route) * router_line_cost_usd"
  }
 ],
