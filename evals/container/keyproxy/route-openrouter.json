{
  "secret": "OPENROUTER_API_KEY",
  "placeholder": "held-by-the-eval-key-proxy",
  "base_url_env": "OPENROUTER_BASE_URL",
  "upstream": "https://openrouter.ai",
  "prefix": "/api/v1/",
  "paths": ["/api/v1/chat/completions"],
  "usage": "openrouter-chat",
  "metered": ["/api/v1/chat/completions"],
  "default_reserve_tokens": 32000,
  "refuse_body_keys": ["models", "route"],
  "port": 8890,
  "timeout_seconds": 600,
  "max_body_bytes": 67108864
}
