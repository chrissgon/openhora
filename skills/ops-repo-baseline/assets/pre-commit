#!/usr/bin/env bash
# Pre-commit checks. Enable them once per clone: git config core.hooksPath .githooks
# 1. The secret scan of the working tree (scripts/secret-scan/secret_scan.py).
# 2. The project's fast checks: <lint command>, <test command>.
# Skipping the hook (git commit --no-verify) is the user's decision, never an agent's.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 scripts/secret-scan/secret_scan.py || { echo "pre-commit: a secret or credential file was found (listed above). Remove it; a planted test value is allowed by a line in .secret-scan-allow with its reason." >&2; exit 1; }
# Optional second scanner. Keep this block only when the user chose "bundled + gitleaks"; delete it otherwise.
# The hook never downloads: the pinned binary is put in scripts/secret-scan/bin once per clone by
# python3 scripts/secret-scan/gitleaks_setup.py. Without it the line below is printed and the commit goes on.
if [ -x scripts/secret-scan/bin/gitleaks ] && [ "$(cat scripts/secret-scan/bin/gitleaks.version 2>/dev/null)" = "8.30.1" ]; then
  scripts/secret-scan/bin/gitleaks git --staged --redact --no-banner --config scripts/secret-scan/gitleaks.toml . || { echo "pre-commit: gitleaks found a secret in the staged changes (listed above, redacted). Remove it and revoke it with its provider." >&2; exit 1; }
else
  echo "pre-commit: gitleaks 8.30.1 is not set up, only the bundled scan ran; run: python3 scripts/secret-scan/gitleaks_setup.py" >&2
fi
<lint command>
<test command>
